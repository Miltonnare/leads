# Chameleon Lead Recovery Engine - Environment Variables Configuration

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Optional Supavisor / PgBouncer pooled endpoint
SUPABASE_POOLER_URL=

# Meta WhatsApp Cloud API Credentials (Master Fallback)
WHATSAPP_CLOUD_API_TOKEN=EAA...
WHATSAPP_PHONE_NUMBER_ID=1092837465...
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHAMELEON_VERIFY_SECRET_2026
WHATSAPP_APP_SECRET=

# Africa's Talking Credentials (Kenya & International SMS)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=atsk_...
AFRICASTALKING_WEBHOOK_SECRET=
# Set to true only for local/staging unsigned webhook dry-runs
ALLOW_UNSIGNED_WEBHOOKS=false

# Security, Demo Signing & Multi-Tenant Token Encryption
DEMO_SIGNING_SECRET=replace-with-64-char-hex-secret
ADMIN_API_KEY=replace-with-strong-admin-api-key
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex-key

# Rate Limiting & Async Waterfall Queue (Optional Upstash)
RATE_LIMIT_IP_PER_MINUTE=12
RATE_LIMIT_PHONE_PER_10M=5
WATERFALL_SMS_DELAY_MS=15000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
INTERNAL_CALLBACK_SECRET=
CRON_SECRET=replace-with-strong-cron-secret
SLA_ESCALATE_AFTER_SECONDS=300
SLA_EXPIRE_AFTER_SECONDS=3600

# Application Configuration
NEXT_PUBLIC_APP_URL=https://chameleon-engine.vercel.app
